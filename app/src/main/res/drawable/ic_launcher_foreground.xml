    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.15"
        android:scaleY="0.15"
        android:translateX="15.6"
        android:translateY="15.6">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M112,96 h128 a160,160 0 0 1 0,320 H112 z M176,176 h56 a80,80 0 0 1 0,160 h-56 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M176,218 h74 v26 h-74 z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M176,268 h100 v26 h-100 z" />
    </group>
</vector>
